{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    { "name": "base", "hidden": true, "generator": "Visual Studio 17 2022", "binaryDir": "${sourceDir}/build/${presetName}" },
    { "name": "x64-release", "inherits": "base", "architecture": "x64" },
    { "name": "win32-release", "inherits": "base", "architecture": "Win32" }
  ],
  "buildPresets": [
    { "name": "x64-release", "configurePreset": "x64-release", "configuration": "Release" },
    { "name": "win32-release", "configurePreset": "win32-release", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "x64-release", "configurePreset": "x64-release", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "win32-release", "configurePreset": "win32-release", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}

